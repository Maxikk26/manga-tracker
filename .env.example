# Copy to .env, or pass via Compose's env_file: / `uv run --env-file` (no
# dotenv is loaded by the app itself — design D7).

# Required by any subcommand that sends. `seed` runs without these (D7).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Defaults if unset: data/manga-tracker.db, INFO, and 3 (local hour).
DB_PATH=data/manga-tracker.db
LOG_LEVEL=INFO
ACTIVE_SWEEP_HOUR=3
